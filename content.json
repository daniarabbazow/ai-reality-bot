    {
      "id": "poems",
      "title": "✍️ Стихи",
      "categories": [
        {
          "id": "poems",
          "title": "📜 Классика",
          "levels": [
        {
          "level": 1,
          "title": "Уровень 1 · лёгкий",
          "items": [
            {"id": "poems_l1_01", "type": "text", "answer": "ai", "note": "ИИ", "text": "Осенний ветер шепчет в тишине,\nИ листья кружат в золотом огне,\nДуша моя наполнена мечтой,\nИ сердце бьётся вместе с красотой."},
            {"id": "poems_l1_02", "type": "text", "answer": "real", "note": "Ф. Тютчев", "text": "Есть в осени первоначальной\nКороткая, но дивная пора —\nВесь день стоит как бы хрустальный,\nИ лучезарны вечера…"},
            {"id": "poems_l1_03", "type": "text", "answer": "real", "note": "А. Фет", "text": "Чудная картина,\nКак ты мне родна:\nБелая равнина,\nПолная луна,"},
            {"id": "poems_l1_04", "type": "text", "answer": "ai", "note": "ИИ", "text": "Зима пришла, укрыв поля собой,\nСверкает снег волшебной белизной,\nИ в этот миг прекрасный и простой\nЯ чувствую гармонию с душой."},
            {"id": "poems_l1_05", "type": "text", "answer": "real", "note": "И. Бунин", "text": "Лес, точно терем расписной,\nЛиловый, золотой, багряный,\nВесёлой, пёстрою стеной\nСтоит над светлою поляной."}
          ]
        },
        {
          "level": 2,
          "title": "Уровень 2 · средний",
          "items": [
            {"id": "poems_l2_01", "type": "text", "answer": "real", "note": "К. Бальмонт", "text": "Я мечтою ловил уходящие тени,\nУходящие тени погасавшего дня,\nЯ на башню всходил, и дрожали ступени,\nИ дрожали ступени под ногой у меня."},
            {"id": "poems_l2_02", "type": "text", "answer": "ai", "note": "ИИ", "text": "Ещё заря над речкою дымится,\nЕщё росой подёрнут сонный луг,\nА в ивняке проснувшаяся птица\nРоняет первый робкий, чистый звук."},
            {"id": "poems_l2_03", "type": "text", "answer": "ai", "note": "ИИ", "text": "Я не люблю пустых осенних комнат,\nГде тень от лампы ляжет на паркет,\nГде вещи всё о прошлом смутно помнят,\nА нас самих давно в них нет и нет."},
            {"id": "poems_l2_04", "type": "text", "answer": "real", "note": "И. Анненский", "text": "Среди миров, в мерцании светил\nОдной Звезды я повторяю имя…\nНе потому, чтоб я Её любил,\nА потому, что я томлюсь с другими."},
            {"id": "poems_l2_05", "type": "text", "answer": "ai", "note": "ИИ", "text": "Я слушал шорох тающего снега,\nЯ слушал шорох тающего дня,\nИ в тишине неслышная победа\nВесны над миром трогала меня."}
          ]
        },
        {
          "level": 3,
          "title": "Уровень 3 · сложный",
          "items": [
            {"id": "poems_l3_01", "type": "text", "answer": "real", "note": "В. Хлебников", "text": "Бобэоби пелись губы,\nВээоми пелись взоры,\nПиээо пелись брови,\nЛиэээй — пелся облик,"},
            {"id": "poems_l3_02", "type": "text", "answer": "ai", "note": "ИИ", "text": "Был вечер ландышевый, томный, лиловатый,\nШампанское искрилось в хрустале,\nИ я, поэт, немного виноватый,\nПисал сонет на вашем рукаве."},
            {"id": "poems_l3_03", "type": "text", "answer": "real", "note": "Ф. Сологуб", "text": "Я — бог таинственного мира,\nВесь мир в одних моих мечтах.\nНе сотворю себе кумира\nНи на земле, ни в небесах."},
            {"id": "poems_l3_04", "type": "text", "answer": "ai", "note": "ИИ", "text": "Я — тень от облака на поле,\nЯ — след весла в ночной воде,\nМеня и нет, и я на воле,\nЯ всюду есть — и я нигде."},
            {"id": "poems_l3_05", "type": "text", "answer": "real", "note": "И. Северянин", "text": "Это было у моря, где ажурная пена,\nГде встречается редко городской экипаж…\nКоролева играла — в башне замка — Шопена,\nИ, внимая Шопену, полюбил её паж."}
          ]
        }
      ]
    }
